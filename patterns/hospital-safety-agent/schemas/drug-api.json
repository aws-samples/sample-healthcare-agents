{
  "openapi": "3.0.0",
  "info": {
    "title": "FDA Drug API",
    "description": "OpenFDA Drug API for accessing drug adverse events, labeling, and enforcement data",
    "version": "1.0.0",
    "contact": {
      "url": "https://open.fda.gov/apis/drug/"
    },
    "license": {
      "name": "Public Domain",
      "url": "https://open.fda.gov/license/"
    }
  },
  "servers": [
    {
      "url": "https://api.fda.gov/drug",
      "description": "FDA Production API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {}
  ],
  "paths": {
    "/event.json": {
      "get": {
        "summary": "Drug Adverse Event Reports",
        "description": "Query FDA Adverse Event Reporting System (FAERS) data",
        "operationId": "getDrugEvents",
        "security": [
          { "ApiKeyAuth": [] },
          {}
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search query (e.g., patient.drug.openfda.brand_name:\"Lipitor\")",
            "schema": {
              "type": "string"
            },
            "example": "patient.drug.openfda.brand_name:Lipitor"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results to return (max 1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1
            }
          },
          {
            "name": "skip",
            "in": "query",
            "description": "Number of results to skip (for pagination)",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count records by specified field",
            "schema": {
              "type": "string"
            },
            "example": "patient.reaction.reactionmeddrapt.exact"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrugEventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "No results found"
          }
        }
      }
    },
    "/label.json": {
      "get": {
        "summary": "Drug Product Labeling",
        "description": "Query drug labeling information (package inserts)",
        "operationId": "getDrugLabels",
        "security": [
          { "ApiKeyAuth": [] },
          {}
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search query",
            "schema": {
              "type": "string"
            },
            "example": "openfda.brand_name:Lipitor"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrugLabelResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ndc.json": {
      "get": {
        "summary": "National Drug Code Directory",
        "description": "Query NDC directory data",
        "operationId": "getDrugNDC",
        "security": [
          { "ApiKeyAuth": [] },
          {}
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/enforcement.json": {
      "get": {
        "summary": "Drug Recall Enforcement Reports",
        "description": "Query drug recall and enforcement data",
        "operationId": "getDrugEnforcement",
        "security": [
          { "ApiKeyAuth": [] },
          {}
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "Optional FDA API key. Public endpoints are usable without a key but are rate-limited to 240 requests/min per IP."
      }
    },
    "schemas": {
      "DrugEventResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "results": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/DrugEvent"
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "disclaimer": {
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "last_updated": {
            "type": "string"
          },
          "results": {
            "type": "object",
            "properties": {
              "skip": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          }
        }
      },
      "DrugEvent": {
        "type": "object",
        "properties": {
          "safetyreportid": {
            "type": "string"
          },
          "receivedate": {
            "type": "string"
          },
          "serious": {
            "type": "string"
          },
          "seriousnessdeath": {
            "type": "string"
          },
          "patient": {
            "$ref": "#/components/schemas/Patient"
          }
        }
      },
      "Patient": {
        "type": "object",
        "properties": {
          "patientonsetage": {
            "type": "string"
          },
          "patientsex": {
            "type": "string"
          },
          "reaction": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "reactionmeddrapt": {
                  "type": "string"
                }
              }
            }
          },
          "drug": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "medicinalproduct": {
                  "type": "string"
                },
                "openfda": {
                  "$ref": "#/components/schemas/OpenFDA"
                }
              }
            }
          }
        }
      },
      "OpenFDA": {
        "type": "object",
        "properties": {
          "brand_name": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            }
          },
          "generic_name": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            }
          },
          "manufacturer_name": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DrugLabelResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "results": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "effective_time": {
                  "type": "string"
                },
                "openfda": {
                  "$ref": "#/components/schemas/OpenFDA"
                },
                "indications_and_usage": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string"
                  }
                },
                "dosage_and_administration": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
